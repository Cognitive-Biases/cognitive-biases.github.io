{
  "$schema": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/v0.1.0/schema/site-profile.schema.json",
  "profileVersion": "0.1",
  "id": "cognitive-biases-knowledge",
  "name": "Cognitive Biases Knowledge Library",
  "canonicalUrl": "https://cognitive-biases.github.io/",
  "description": "Public knowledge library about cognitive biases, evidence and decision making with versioned data, monthly evidence updates, retrieval-ready releases, explicit research maturity and a local read-only MCP adapter.",
  "languages": ["en", "de", "ru"],
  "web": {
    "sitemap": "https://cognitive-biases.github.io/sitemap.xml",
    "robots": "https://cognitive-biases.github.io/robots.txt",
    "llms": "https://cognitive-biases.github.io/llms.txt",
    "feeds": [
      {
        "url": "https://cognitive-biases.github.io/research/feed.xml",
        "mediaType": "application/atom+xml",
        "title": "Cognitive Biases Research"
      }
    ]
  },
  "data": {
    "catalog": "https://cognitive-biases.github.io/data/catalog.json",
    "schemas": "https://raw.githubusercontent.com/Cognitive-Biases/cognitive-biases.github.io/main/schemas/reasoning-practice.schema.json",
    "distributions": [
      {
        "name": "Knowledge release manifest",
        "url": "https://cognitive-biases.github.io/data/manifest.json",
        "mediaType": "application/json",
        "role": "release",
        "description": "Versioned knowledge-release manifest with file hashes and release metadata."
      },
      {
        "name": "Monthly research evidence deltas",
        "url": "https://cognitive-biases.github.io/data/monthly-research-digests.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Monthly reviewed research signals labeled as strengthening, narrowing, new context or watch-only, with practical checks and resulting project changes."
      },
      {
        "name": "Retrieval distribution",
        "url": "https://cognitive-biases.github.io/data/rag.ndjson",
        "mediaType": "application/x-ndjson",
        "role": "rag",
        "description": "Retrieval-ready public knowledge distribution preserving canonical knowledge context."
      },
      {
        "name": "Agent locale manifest",
        "url": "https://cognitive-biases.github.io/ai/locales.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Canonical English plus German and Russian agent-routing surfaces with deterministic English fallback."
      },
      {
        "name": "Product history",
        "url": "https://cognitive-biases.github.io/history.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Source-backed project timeline, maturity status and current agent-discovery milestone."
      },
      {
        "name": "AI Search and Citation Profile",
        "url": "https://cognitive-biases.github.io/ai/ai-search-profile.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Reusable ARWP implementation profile describing active, planned and not-applicable citation, trust, localization and discovery modules without a readiness score."
      },
      {
        "name": "Canonical citation index",
        "url": "https://cognitive-biases.github.io/citation-index.json",
        "mediaType": "application/json",
        "role": "search-index",
        "description": "Stable routing index for canonical explanations, evidence, research, methodology and public data surfaces."
      },
      {
        "name": "Trust Center",
        "url": "https://cognitive-biases.github.io/trust/trust.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Machine-readable identity, evidence-review model, security, reuse boundaries and limitations."
      },
      {
        "name": "Corrections ledger",
        "url": "https://cognitive-biases.github.io/trust/corrections.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Public policy and ledger for material factual, evidence, provenance, methodology or data-contract corrections."
      },
      {
        "name": "Knowledge graph",
        "url": "https://cognitive-biases.github.io/knowledge/graph.json",
        "mediaType": "application/ld+json",
        "role": "other",
        "description": "JSON-LD graph linking the website, maintainer organization, public dataset, research program, benchmark, observatory and Trust Center."
      }
    ]
  },
  "retrieval": {
    "indexes": [
      {
        "name": "Cognitive Biases RAG",
        "url": "https://cognitive-biases.github.io/data/rag.ndjson",
        "mediaType": "application/x-ndjson",
        "format": "ndjson",
        "description": "Retrieval-ready distribution generated from the maintained public knowledge release."
      }
    ]
  },
  "mcp": {
    "servers": [
      {
        "name": "cognitive-biases-reference-mcp",
        "transport": "stdio",
        "source": "https://github.com/Cognitive-Biases/cognitive-biases.github.io/tree/main/integrations/mcp",
        "documentation": "https://github.com/Cognitive-Biases/cognitive-biases.github.io/blob/main/integrations/mcp/README.md",
        "readOnly": true
      }
    ]
  },
  "trust": {
    "license": "https://raw.githubusercontent.com/Cognitive-Biases/cognitive-biases.github.io/main/LICENSE",
    "citation": "https://raw.githubusercontent.com/Cognitive-Biases/cognitive-biases.github.io/main/CITATION.cff",
    "provenance": "https://cognitive-biases.github.io/data/provenance.json",
    "reviewPolicy": "https://github.com/Cognitive-Biases/cognitive-biases.github.io/blob/main/CONTRIBUTING.md",
    "security": "https://github.com/Cognitive-Biases/cognitive-biases.github.io/blob/main/SECURITY.md"
  },
  "extensions": {
    "io.github.dkharlanau/localized-llms": {
      "version": "0.1",
      "status": "experimental-project-extension",
      "defaultLanguage": "en",
      "fallbackLanguage": "en",
      "humanInterfaceLanguages": ["en"],
      "agentRoutingLanguages": ["en", "de", "ru"],
      "manifest": "https://cognitive-biases.github.io/ai/locales.json"
    },
    "io.github.dkharlanau/ai-search-profile": {
      "version": "0.1",
      "status": "experimental-project-profile",
      "profile": "https://cognitive-biases.github.io/ai/ai-search-profile.json",
      "schema": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/ai-search-profile.schema.json",
      "documentation": "https://dkharlanau.github.io/agent-ready-web-profile/AI-SEARCH-PROFILE.md",
      "citationIndex": "https://cognitive-biases.github.io/citation-index.json",
      "trustCenter": "https://cognitive-biases.github.io/trust/trust.json",
      "correctionsLedger": "https://cognitive-biases.github.io/trust/corrections.json",
      "knowledgeGraph": "https://cognitive-biases.github.io/knowledge/graph.json"
    },
    "io.github.dkharlanau/trust-center": {
      "version": "0.1",
      "status": "active-project-policy",
      "human": "https://cognitive-biases.github.io/trust/",
      "machine": "https://cognitive-biases.github.io/trust/trust.json",
      "securityPolicy": "https://github.com/Cognitive-Biases/cognitive-biases.github.io/blob/main/SECURITY.md",
      "corrections": "https://cognitive-biases.github.io/trust/corrections.json"
    }
  }
}
