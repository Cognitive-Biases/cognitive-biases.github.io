      "paths": ["data/skills/**"],
      "surface": "decisionSkills",
      "mode": "exact-checkers",
      "locales": ["fr", "pt-BR"]
    },
    {
      "id": "ui-and-templates",
      "paths": ["index.html", "assets/**", "scripts/build-*.mjs"],
      "surface": "humanInterface",
      "mode": "review-required",
      "locales": ["fr", "pt-BR"]
    },
    {
      "id": "ai-agent-surfaces",
      "paths": ["ai/**", "skills/**", "llms.txt"],
      "surface": "agentRouting",
      "mode": "review-required",
      "locales": ["de", "ru", "fr", "pt-BR"]
    }
  ],
  "exceptionsFile": "data/localization-exceptions.json",
  "evidenceBoundary": "Passing localization checks proves only the checked repository/build/rendered contract, not indexing, ranking, citation, recommendation visibility or traffic."
